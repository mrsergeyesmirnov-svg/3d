# Server-only. NEVER prefix these values with NEXT_PUBLIC_.
YANDEX_AI_API_KEY=
YANDEX_FOLDER_ID=
# Optional: otherwise gpt://<folder-id>/yandexgpt/latest
YANDEX_MODEL_URI=

# PostgreSQL in a Russian data center (for example, Yandex Managed PostgreSQL)
DATABASE_URL=
DATABASE_SSL=true
# Enables real order submissions only once legal/operator info is supplied
COMPANY_NAME=
PRIVACY_POLICY_URL=

# Optional: public site URL to verify request origins in production
SITE_URL=